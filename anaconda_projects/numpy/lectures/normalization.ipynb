   "source": [
    "arr = np.array([[1,2],[3,4]])\n",
    "print(arr)\n",
    "mean = np.mean(arr)\n",
    "print(mean)\n",
    "std_dev = np.std(arr)\n",
    "print(std_dev)\n",
    "normalized_arr = (arr-mean)/std_dev\n",
    "print(normalized_arr)\n",
    "print(np.mean(normalized_arr))\n",
    "print(np.std(normalized_arr))"
   ]
